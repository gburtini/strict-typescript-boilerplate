{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/check-enforcement-fixtures.mjs",
        "scripts/check-package-exports.mjs"
      ],
      "project": ["scripts/**/*.mjs"]
    },
    "apps/web": {
      "entry": ["index.html"],
      "project": ["src/**/*.{ts,tsx,css}"],
      "ignoreDependencies": ["@template/ui"]
    },
    "packages/ui": {
      "entry": ["src/components/ui/*.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
