{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/check-package-exports.ts",
        "scripts/check-enforcement-fixtures.ts",
        "scripts/check-exceptions.ts",
        "scripts/check-architecture-fixtures.ts",
        "scripts/check-ci-policy.ts",
        "scripts/check-generated.ts",
        "scripts/check-test-evidence.ts",
        "scripts/check-coverage-ratchet.ts",
        "scripts/generate-enforcement-manifest.ts"
      ],
      "project": ["scripts/**/*.ts"]
    },
    "apps/web": {
      "entry": ["index.html"],
      "project": ["src/**/*.{ts,tsx,css}"],
      "ignoreDependencies": ["@template/ui"]
    },
    "packages/ui": {
      "entry": ["src/components/ui/*.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
