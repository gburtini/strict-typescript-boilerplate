{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "devtools/scripts/repository/check-package-exports.ts",
        "devtools/scripts/repository/check-enforcement-fixtures.ts",
        "devtools/scripts/repository/check-exceptions.ts",
        "devtools/scripts/repository/check-architecture-fixtures.ts",
        "devtools/scripts/repository/check-ci-policy.ts",
        "devtools/scripts/repository/check-generated.ts",
        "devtools/scripts/repository/check-test-evidence.ts",
        "devtools/scripts/repository/check-coverage-ratchet.ts",
        "devtools/scripts/repository/check-db-migrations.ts",
        "devtools/scripts/repository/generate-enforcement-manifest.ts"
      ],
      "ignoreDependencies": ["@effect/tsgo"],
      "project": ["devtools/scripts/**/*.ts"]
    },
    "apps/web": {
      "entry": ["index.html", "src/env.ts"],
      "project": ["src/**/*.{ts,tsx,css}"],
      "ignoreDependencies": ["@template/ui", "@t3-oss/env-core", "zod"]
    },
    "packages/ui": {
      "entry": ["src/components/ui/*.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/core": {
      "entry": [
        "src/index.ts",
        "src/api/index.ts",
        "src/api/contract.ts",
        "src/api/router.ts",
        "src/telemetry-node.ts"
      ],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@orpc/contract", "@orpc/server", "zod"]
    },
    "packages/db": {
      "entry": ["src/index.ts", "drizzle.config.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@t3-oss/env-core", "drizzle-zod", "zod"]
    }
  }
}
