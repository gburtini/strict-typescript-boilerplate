{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/web": {
      "entry": ["index.html"],
      "project": ["src/**/*.{ts,tsx,css}"],
      "ignoreDependencies": ["@template/ui"]
    },
    "packages/ui": {
      "entry": ["src/components/ui/*.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
