{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["files"],
  "additionalProperties": false,
  "properties": {
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["output", "source", "checkCommand"],
        "additionalProperties": false,
        "properties": {
          "output": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "checkCommand": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
