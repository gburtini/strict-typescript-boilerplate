{
  "$schema": "https://oxc.rs/schema/oxlint.json",
  "options": {
    "typeAware": true,
    "typeCheck": true,
  },
  "globals": {
    "console": "readonly",
    "document": "readonly",
    "process": "readonly",
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "nursery": "error",
    "restriction": "error",
  },
  "plugins": [
    "import",
    "jsx-a11y",
    "promise",
    "react",
    "typescript",
    "unicorn",
    "vitest",
  ],
  "jsPlugins": [
    {
      "name": "shadcn",
      "specifier": "@shadcn/lint",
    },
    {
      "name": "gdp-ts",
      "specifier": "@gdp-ts/core/lint/plugin",
    },
    {
      "name": "@rikalabs",
      "specifier": "@rikalabs/oxlint-standards/plugin",
    },
    {
      "name": "react-quality",
      "specifier": "oxlint-plugin-react-doctor",
    },
    {
      "name": "drizzle",
      "specifier": "eslint-plugin-drizzle",
    },
  ],
  "settings": {
    "shadcn": {
      "note": "Use semantic theme tokens, primitive variants, and the shared spacing scale. Exceptions require an explained suppression.",
      "ui": "@template/ui",
    },
  },
  "rules": {
    "eslint/func-style": "off",
    "eslint/no-magic-numbers": "off",
    "eslint/one-var": "off",
    "eslint/sort-imports": "off",
    "eslint/sort-vars": "off",
    "eslint/sort-keys": "off",
    "import/no-relative-parent-imports": "off",
    "import/no-named-export": "off",
    "import/no-commonjs": "error",
    "import/no-default-export": "error",
    "import/no-nodejs-modules": [
      "error",
      {
        "allow": [
          "node:child_process",
          "node:crypto",
          "node:fs",
          "node:fs/promises",
          "node:os",
          "node:path",
          "node:http",
          "node:events",
        ],
      },
    ],
    "import/consistent-type-specifier-style": [
      "error",
      "prefer-top-level-if-only-type-imports",
    ],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"],
      },
    ],
    "import/prefer-default-export": "off",
    "no-console": "error",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "react/button-has-type": "error",
    "react/no-danger-with-children": "error",
    "react/no-find-dom-node": "error",
    "react/no-string-refs": "error",
    "gdp-ts/no-define-proof": "error",
    "gdp-ts/no-exported-prover": "error",
    "gdp-ts/no-proof-assertion": "error",
    "gdp-ts/no-type-assertion": "error",
    "gdp-ts/no-any": "error",
    "typescript/no-require-imports": "error",
    "typescript/only-throw-error": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/explicit-function-return-type": "error",
    "typescript/explicit-module-boundary-types": "error",
    "max-depth": ["error", 4],
    "max-lines": [
      "error",
      {
        "max": 500,
        "skipBlankLines": true,
        "skipComments": true,
      },
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 80,
        "skipBlankLines": true,
        "skipComments": true,
      },
    ],
    "max-params": ["error", 5],
    "max-statements": ["error", 40],
    "no-restricted-properties": [
      "error",
      {
        "message": "Import useState directly from react.",
        "object": "React",
        "property": "useState",
      },
      {
        "message": "Import useEffect directly from react.",
        "object": "React",
        "property": "useEffect",
      },
      {
        "message": "Import useMemo directly from react.",
        "object": "React",
        "property": "useMemo",
      },
      {
        "message": "sql.raw() is prohibited. Use parameterized sql`` or a reviewed migration exception.",
        "object": "sql",
        "property": "raw",
      },
    ],
    "no-with": "error",
    "no-unsafe-optional-chaining": "error",
    "promise/no-multiple-resolved": "error",
    "promise/no-return-in-finally": "error",
    "react/error-boundaries": "error",
    "react/exhaustive-deps": "off",
    "react/globals": "error",
    "react/hook-use-state": "error",
    "react/immutability": "error",
    "react/incompatible-library": "error",
    "react/no-danger": "error",
    "react/react-in-jsx-scope": "off",
    "react/forbid-component-props": "off",
    "react/jsx-filename-extension": "off",
    "react/jsx-pascal-case": "error",
    "react/jsx-no-literals": "off",
    "react/jsx-max-depth": "off",
    "react/jsx-props-no-spreading": "off",
    "react/purity": "error",
    "react/preserve-manual-memoization": "error",
    "react/refs": "error",
    "react/set-state-in-effect": "error",
    "react/set-state-in-render": "error",
    "react/static-components": "error",
    "react/unsupported-syntax": "error",
    "react/use-memo": "error",
    "typescript/await-thenable": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "fixStyle": "inline-type-imports",
        "prefer": "type-imports",
      },
    ],
    "typescript/no-deprecated": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-explicit-any": "error",
    "typescript/prefer-readonly": "error",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/require-array-sort-compare": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/strict-boolean-expressions": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/unbound-method": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/no-confusing-void-expression": [
      "error",
      {
        "ignoreArrowShorthand": true,
        "ignoreVoidOperator": true,
        "ignoreVoidReturningFunctions": true,
      },
    ],
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase",
      },
    ],
    "unicorn/import-style": "error",
    "unicorn/no-abusive-eslint-disable": "error",
    "unicorn/no-invalid-fetch-options": "error",
    "unicorn/no-invalid-remove-event-listener": "error",
    "unicorn/no-thenable": "error",
    "import/no-cycle": "error",
    "vitest/no-importing-vitest-globals": "off",
    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "error",
    "vitest/no-standalone-expect": "error",
    "vitest/valid-expect": "error",
    "vitest/valid-describe-callback": "error",
    "vitest/require-to-throw-message": "error",
    "vitest/no-conditional-expect": "error",
    "vitest/no-conditional-tests": "error",
    "vitest/require-test-timeout": "off",
    "@rikalabs/no-unlisted-external-imports": "off",
    "@rikalabs/no-generic-module-names": "off",
    "@rikalabs/no-placeholder-implementation": "off",
    "vitest/require-hook": "off",
    "shadcn/no-arbitrary-values": "error",
    "shadcn/no-inline-styles": "error",
    "shadcn/no-raw-colors": "error",
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"],
        "contracts": [
          {
            "allow": ["layout"],
            "deny": ["w-*", "h-*"],
            "pattern": "^Button$",
          },
          {
            "allow": ["layout"],
            "pattern": "^(Card|Input|Label)$",
          },
        ],
      },
    ],
    "shadcn/no-unknown-classes": "error",
    "shadcn/require-static-classes": "error",
    "react/rules-of-hooks": "off",
    "react-quality/react-in-jsx-scope": "off",
    "react-quality/jsx-props-no-spreading": "off",
    "@rikalabs/no-silent-catch-fallback": "error",
    "@rikalabs/no-is-record-helpers": "error",
    "@rikalabs/no-runtime-compat-fallbacks": "error",
    "@rikalabs/no-catch-return-error-object": "error",
    "@rikalabs/no-double-type-assertion": "error",
    "@rikalabs/no-ai-debt-comments": "error",
    "@rikalabs/no-json-parse-default-fallback": "error",
    "@rikalabs/no-json-stringify-default-fallback": "error",
    "@rikalabs/no-as-never": "error",
    "@rikalabs/no-todo-without-issue": "error",
    "@rikalabs/no-disable-without-rationale": "error",
    "@rikalabs/no-identical-branches": "error",
    "@rikalabs/no-copy-paste-exports": "error",
    "@rikalabs/no-trivial-runtime-guard-helpers": "error",
    "@rikalabs/no-trivial-property-helpers": "error",
    "@rikalabs/no-bare-wrapper-functions": "error",
    "@rikalabs/no-pass-through-intermediate-vars": "error",
    "@rikalabs/no-redundant-const-assertion": "error",
    "@rikalabs/no-tutorial-comments": "error",
    "@rikalabs/no-commented-out-code": "error",
    "@rikalabs/no-debug-residue-filenames": "error",
    "@rikalabs/no-low-signal-variable-names": "error",
    "@rikalabs/effect-no-async-await": "error",
    "@rikalabs/effect-no-generic-error-fail": "error",
    "@rikalabs/effect-no-layer-in-leaf-modules": "error",
    "@rikalabs/effect-no-or-die": "error",
    "@rikalabs/effect-no-promise-service-methods": "error",
    "@rikalabs/effect-no-provide-in-domain": "error",
    "@rikalabs/effect-no-terminal-runners": "error",
    "@rikalabs/effect-no-throw-in-services": "error",
    "@rikalabs/effect-no-try-catch": "error",
    "@rikalabs/effect-require-tagged-errors": "error",
    "@rikalabs/no-standalone-classes": "error",
    "@rikalabs/no-sql-string-concat": "error",
    "@rikalabs/no-exported-any": "error",
    "@rikalabs/no-inline-exported-object-types": "error",
    "@rikalabs/no-bag-of-optionals": "error",
    "@rikalabs/require-branded-ids": "error",
    "@rikalabs/require-exhaustive-tag-switch": "error",
    "@rikalabs/no-relative-cross-package-imports": "error",
    "unicorn/max-nested-calls": "off",
    "@rikalabs/no-cross-layer-imports": "error",
    "@rikalabs/no-placeholder-tests": "error",
    "@rikalabs/no-mock-only-tests": "error",
    "drizzle/enforce-delete-with-where": "error",
    "drizzle/enforce-update-with-where": "error",
    "vitest/consistent-test-filename": "error",
    "vitest/prefer-called-once": "error",
    "vitest/prefer-called-times": "error",
    "vitest/prefer-to-be-object": "error",
    "@rikalabs/no-hardcoded-secrets": "error",
    "react-quality/active-static-asset": "warn",
    "react-quality/activity-wraps-effect-heavy-subtree": "warn",
    "react-quality/advanced-event-handler-refs": "warn",
    "react-quality/agent-tool-capability-risk": "warn",
    "react-quality/alt-text": "warn",
    "react-quality/anchor-ambiguous-text": "warn",
    "react-quality/anchor-has-content": "warn",
    "react-quality/anchor-is-valid": "warn",
    "react-quality/anchor-target-exists": "warn",
    "react-quality/aria-activedescendant-has-tabindex": "warn",
    "react-quality/aria-braille-equivalent": "warn",
    "react-quality/aria-props": "warn",
    "react-quality/aria-proptypes": "warn",
    "react-quality/aria-role": "warn",
    "react-quality/aria-unsupported-elements": "warn",
    "react-quality/artifact-baas-authority-surface": "warn",
    "react-quality/artifact-env-leak": "warn",
    "react-quality/artifact-secret-leak": "warn",
    "react-quality/async-await-in-loop": "warn",
    "react-quality/async-defer-await": "warn",
    "react-quality/async-parallel": "warn",
    "react-quality/auth-token-in-web-storage": "warn",
    "react-quality/autocomplete-valid": "warn",
    "react-quality/build-pipeline-secret-boundary": "warn",
    "react-quality/button-has-type": "warn",
    "react-quality/checked-requires-onchange-or-readonly": "warn",
    "react-quality/class-component-missing-component-will-unmount-teardown": "warn",
    "react-quality/click-events-have-key-events": "warn",
    "react-quality/clickjacking-redirect-risk": "warn",
    "react-quality/client-localstorage-no-version": "warn",
    "react-quality/client-passive-event-listeners": "warn",
    "react-quality/command-execution-input-risk": "warn",
    "react-quality/control-has-associated-label": "warn",
    "react-quality/cors-cookie-trust-risk": "warn",
    "react-quality/dangerous-html-sink": "warn",
    "react-quality/data-table-requires-accessible-name": "warn",
    "react-quality/debounce-no-cleanup": "warn",
    "react-quality/design-no-em-dash-in-jsx-text": "warn",
    "react-quality/design-no-redundant-padding-axes": "warn",
    "react-quality/design-no-redundant-size-axes": "warn",
    "react-quality/design-no-space-on-flex-children": "warn",
    "react-quality/design-no-three-period-ellipsis": "warn",
    "react-quality/design-no-vague-button-label": "warn",
    "react-quality/details-requires-summary": "warn",
    "react-quality/dialog-has-accessible-name": "warn",
    "react-quality/display-name": "warn",
    "react-quality/effect-listener-cleanup-mismatch": "warn",
    "react-quality/effect-listener-cleanup-reference-mismatch": "warn",
    "react-quality/effect-needs-cleanup": "warn",
    "react-quality/effect-observer-needs-disconnect": "warn",
    "react-quality/effect-raf-loop-needs-cancel": "warn",
    "react-quality/effect-remove-listener-inline-handler": "warn",
    "react-quality/empty-table-header": "warn",
    "react-quality/exhaustive-deps": "warn",
    "react-quality/fieldset-requires-legend": "warn",
    "react-quality/firebase-client-owned-authz-field": "warn",
    "react-quality/firebase-permissive-rules": "warn",
    "react-quality/firebase-query-filter-as-auth": "warn",
    "react-quality/forbid-component-props": "warn",
    "react-quality/forbid-dom-props": "warn",
    "react-quality/forbid-elements": "warn",
    "react-quality/form-control-requires-name": "warn",
    "react-quality/forward-ref-uses-ref": "warn",
    "react-quality/git-provider-url-injection-risk": "warn",
    "react-quality/heading-has-content": "warn",
    "react-quality/hook-import-rename-loses-use-prefix": "warn",
    "react-quality/hook-use-state": "warn",
    "react-quality/hooks-no-nan-in-deps": "warn",
    "react-quality/html-has-lang": "warn",
    "react-quality/html-label-has-single-control": "warn",
    "react-quality/html-no-invalid-paragraph-child": "warn",
    "react-quality/html-no-invalid-table-nesting": "warn",
    "react-quality/html-no-nested-form": "warn",
    "react-quality/html-no-nested-interactive": "warn",
    "react-quality/html-xml-lang-mismatch": "warn",
    "react-quality/iframe-has-title": "warn",
    "react-quality/iframe-missing-sandbox": "warn",
    "react-quality/iframe-title-unique": "warn",
    "react-quality/img-redundant-alt": "warn",
    "react-quality/import-metadata-execution-risk": "warn",
    "react-quality/ink-ctrl-c-handler-requires-exit-option": "warn",
    "react-quality/ink-newline-inside-text": "warn",
    "react-quality/ink-no-bare-process-exit": "warn",
    "react-quality/ink-no-direct-raw-mode": "warn",
    "react-quality/ink-no-dom-host-elements": "warn",
    "react-quality/ink-no-dom-router": "warn",
    "react-quality/ink-no-focus-in-render": "warn",
    "react-quality/ink-no-layout-inside-text": "warn",
    "react-quality/ink-no-live-hooks-in-render-to-string": "warn",
    "react-quality/ink-no-measure-element-in-render": "warn",
    "react-quality/ink-no-multiple-static": "warn",
    "react-quality/ink-no-raw-text": "warn",
    "react-quality/ink-no-repeated-render": "warn",
    "react-quality/ink-prefer-use-animation": "warn",
    "react-quality/ink-prefer-use-paste": "warn",
    "react-quality/ink-static-is-append-only": "warn",
    "react-quality/ink-static-requires-key": "warn",
    "react-quality/ink-suspense-requires-concurrent": "warn",
    "react-quality/ink-use-reactive-window-size": "warn",
    "react-quality/ink-use-string-width-for-cursor": "warn",
    "react-quality/ink-use-suspend-terminal": "warn",
    "react-quality/ink-valid-aria-semantics": "warn",
    "react-quality/insecure-crypto-risk": "warn",
    "react-quality/insecure-session-cookie": "warn",
    "react-quality/interactive-supports-focus": "warn",
    "react-quality/jotai-derived-atom-returns-fresh-object": "warn",
    "react-quality/jotai-select-atom-in-render-body": "warn",
    "react-quality/jotai-tq-use-raw-query-atom": "warn",
    "react-quality/js-async-reduce-without-awaited-acc": "warn",
    "react-quality/js-batch-dom-css": "warn",
    "react-quality/js-cache-property-access": "warn",
    "react-quality/js-cache-storage": "warn",
    "react-quality/js-combine-iterations": "warn",
    "react-quality/js-early-exit": "warn",
    "react-quality/js-flatmap-filter": "warn",
    "react-quality/js-hoist-intl": "warn",
    "react-quality/js-hoist-regexp": "warn",
    "react-quality/js-index-maps": "warn",
    "react-quality/js-length-check-first": "warn",
    "react-quality/js-min-max-loop": "warn",
    "react-quality/js-set-map-lookups": "warn",
    "react-quality/js-tosorted-immutable": "warn",
    "react-quality/jsx-boolean-value": "warn",
    "react-quality/jsx-curly-brace-presence": "warn",
    "react-quality/jsx-filename-extension": "warn",
    "react-quality/jsx-fragments": "warn",
    "react-quality/jsx-handler-names": "warn",
    "react-quality/jsx-key": "warn",
    "react-quality/jsx-max-depth": "warn",
    "react-quality/jsx-no-comment-textnodes": "warn",
    "react-quality/jsx-no-duplicate-props": "warn",
    "react-quality/jsx-no-script-url": "warn",
    "react-quality/jsx-no-target-blank": "warn",
    "react-quality/jsx-no-undef": "warn",
    "react-quality/jsx-no-useless-fragment": "warn",
    "react-quality/jsx-numeric-and-leaked-render": "warn",
    "react-quality/jsx-pascal-case": "warn",
    "react-quality/jsx-props-no-spread-multi": "warn",
    "react-quality/jwt-insecure-verification": "warn",
    "react-quality/key-lifecycle-risk": "warn",
    "react-quality/label-has-associated-control": "warn",
    "react-quality/lang": "warn",
    "react-quality/loading-action-preserves-trigger": "warn",
    "react-quality/local-rpc-native-bridge-risk": "warn",
    "react-quality/mcp-tool-capability-risk": "warn",
    "react-quality/mdx-ssr-execution-risk": "warn",
    "react-quality/media-has-caption": "warn",
    "react-quality/mobx-no-make-auto-observable-in-inheritance": "warn",
    "react-quality/mobx-no-observer-wrapped-memo": "warn",
    "react-quality/mobx-reaction-disposer-discarded": "warn",
    "react-quality/motion-animate-presence-must-outlive-child": "warn",
    "react-quality/motion-animate-presence-requires-key": "warn",
    "react-quality/motion-animate-presence-wait-single-child": "warn",
    "react-quality/motion-create-in-render": "warn",
    "react-quality/motion-drag-axis-constraint-mismatch": "warn",
    "react-quality/motion-imperative-animation-in-render": "warn",
    "react-quality/motion-keyframe-times-mismatch": "warn",
    "react-quality/motion-layout-on-inline-element": "warn",
    "react-quality/motion-unstable-layout-id-in-iteration": "warn",
    "react-quality/motion-use-transform-range-length": "warn",
    "react-quality/motion-value-constructor-in-render": "warn",
    "react-quality/motion-value-subscription-in-render": "warn",
