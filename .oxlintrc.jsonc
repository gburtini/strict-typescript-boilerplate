    "react-quality/no-access-key": "warn",
    "react-quality/no-adjust-state-on-prop-change": "warn",
    "react-quality/no-all-caps-body-text": "warn",
    "react-quality/no-arbitrary-px-font-size": "warn",
    "react-quality/no-aria-hidden-on-body": "warn",
    "react-quality/no-aria-hidden-on-focusable": "warn",
    "react-quality/no-aria-invalid-without-description": "warn",
    "react-quality/no-arithmetic-on-optional-chained-operand": "warn",
    "react-quality/no-array-find-result-member-access-without-guard": "warn",
    "react-quality/no-array-index-as-key": "warn",
    "react-quality/no-array-index-deref-without-bounds-or-empty-guard": "warn",
    "react-quality/no-array-index-key": "warn",
    "react-quality/no-assertive-status": "warn",
    "react-quality/no-async-effect-callback": "warn",
    "react-quality/no-async-event-handler-without-reentry-guard": "warn",
    "react-quality/no-auto-scrolling-content": "warn",
    "react-quality/no-autofocus": "warn",
    "react-quality/no-autoplay-without-muted": "warn",
    "react-quality/no-barrel-import": "warn",
    "react-quality/no-blocked-paste": "warn",
    "react-quality/no-boolean-toggle-without-functional-update": "warn",
    "react-quality/no-broken-image-source": "warn",
    "react-quality/no-call-component-as-function": "warn",
    "react-quality/no-cascading-set-state": "warn",
    "react-quality/no-chain-state-updates": "warn",
    "react-quality/no-children-prop": "warn",
    "react-quality/no-clipped-overlay": "warn",
    "react-quality/no-clone-element": "warn",
    "react-quality/no-collapse-request-error-to-empty-state": "warn",
    "react-quality/no-collapsed-literal-or-chain-as-value": "warn",
    "react-quality/no-common-root-font": "warn",
    "react-quality/no-conflicting-spring-options": "warn",
    "react-quality/no-controlled-input-value-without-state-update": "warn",
    "react-quality/no-controlled-selection-focus-effect": "warn",
    "react-quality/no-cramped-container-padding": "warn",
    "react-quality/no-create-context-in-render": "warn",
    "react-quality/no-create-object-url-in-render": "warn",
