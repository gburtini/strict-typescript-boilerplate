{
  "$schema": "https://oxc.rs/schema/oxlint.json",
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "globals": {
    "console": "readonly",
    "document": "readonly",
    "process": "readonly"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
    "nursery": "error",
    "restriction": "error"
  },
  "plugins": [
    "import",
    "jsx-a11y",
    "promise",
    "react",
    "typescript",
    "unicorn",
    "vitest"
  ],
  "jsPlugins": [
    {
      "name": "shadcn",
      "specifier": "@shadcn/lint"
    },
    {
      "name": "gdp-ts",
      "specifier": "@gdp-ts/core/lint/plugin"
    }
  ],
  "settings": {
    "shadcn": {
      "note": "Use semantic theme tokens, primitive variants, and the shared spacing scale. Exceptions require an explained suppression.",
      "ui": "@template/ui"
    }
  },
  "rules": {
    "eslint/func-style": "off",
    "eslint/no-magic-numbers": "off",
    "eslint/one-var": "off",
    "eslint/sort-imports": "off",
    "eslint/sort-vars": "off",
    "eslint/sort-keys": "off",
    "import/no-relative-parent-imports": "off",
    "import/no-named-export": "off",
    "import/no-commonjs": "error",
    "import/no-default-export": "error",
    "import/no-nodejs-modules": [
      "error",
      {
        "allow": [
          "node:child_process",
          "node:crypto",
          "node:fs",
          "node:fs/promises",
          "node:os",
          "node:path",
          "node:http",
          "node:events"
        ]
      }
    ],
    "import/consistent-type-specifier-style": [
      "error",
      "prefer-top-level-if-only-type-imports"
    ],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "import/prefer-default-export": "off",
    "no-console": "error",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "react/button-has-type": "error",
    "react/no-danger-with-children": "error",
    "react/no-find-dom-node": "error",
    "react/no-string-refs": "error",
    "gdp-ts/no-define-proof": "error",
    "gdp-ts/no-exported-prover": "error",
    "gdp-ts/no-proof-assertion": "error",
    "gdp-ts/no-type-assertion": "error",
    "gdp-ts/no-any": "error",
    "typescript/no-require-imports": "error",
    "typescript/only-throw-error": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/explicit-function-return-type": "error",
    "typescript/explicit-module-boundary-types": "error",
    "max-depth": ["error", 4],
    "max-lines": [
      "error",
      {
        "max": 500,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines-per-function": [
      "error",
      {
        "max": 80,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-params": ["error", 5],
    "max-statements": ["error", 40],
    "no-restricted-properties": [
      "error",
      {
        "message": "Import useState directly from react.",
        "object": "React",
        "property": "useState"
      },
      {
        "message": "Import useEffect directly from react.",
        "object": "React",
        "property": "useEffect"
      },
      {
        "message": "Import useMemo directly from react.",
        "object": "React",
        "property": "useMemo"
      },
      {
        "message": "sql.raw() is prohibited. Use parameterized sql`` or a reviewed migration exception.",
        "object": "sql",
        "property": "raw"
      }
    ],
    "no-with": "error",
    "no-unsafe-optional-chaining": "error",
    "promise/no-multiple-resolved": "error",
    "promise/no-return-in-finally": "error",
    "react/error-boundaries": "error",
    "react/exhaustive-deps": "off",
    "react/globals": "error",
    "react/hook-use-state": "error",
    "react/immutability": "error",
    "react/incompatible-library": "error",
    "react/no-danger": "error",
    "react/react-in-jsx-scope": "off",
    "react/forbid-component-props": "off",
    "react/jsx-filename-extension": "off",
    "react/jsx-pascal-case": "error",
    "react/jsx-no-literals": "off",
    "react/jsx-max-depth": "off",
    "react/jsx-props-no-spreading": "off",
    "react/purity": "error",
    "react/preserve-manual-memoization": "error",
    "react/refs": "error",
    "react/set-state-in-effect": "error",
    "react/set-state-in-render": "error",
    "react/static-components": "error",
    "react/unsupported-syntax": "error",
    "react/use-memo": "error",
    "typescript/await-thenable": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "fixStyle": "inline-type-imports",
        "prefer": "type-imports"
      }
    ],
    "typescript/no-deprecated": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-explicit-any": "error",
    "typescript/prefer-readonly": "error",
    "typescript/prefer-readonly-parameter-types": "off",
    "typescript/require-array-sort-compare": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/strict-boolean-expressions": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/unbound-method": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/no-confusing-void-expression": [
      "error",
      {
        "ignoreArrowShorthand": true,
        "ignoreVoidOperator": true,
        "ignoreVoidReturningFunctions": true
      }
    ],
    "unicorn/filename-case": [
      "error",
      {
        "case": "kebabCase"
      }
    ],
    "unicorn/import-style": "error",
    "unicorn/no-abusive-eslint-disable": "error",
    "unicorn/no-invalid-fetch-options": "error",
    "unicorn/no-invalid-remove-event-listener": "error",
    "unicorn/no-thenable": "error",
    "import/no-cycle": "error",
    "vitest/no-importing-vitest-globals": "off",
    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "error",
    "vitest/no-standalone-expect": "error",
    "vitest/valid-expect": "error",
    "vitest/valid-describe-callback": "error",
    "vitest/require-to-throw-message": "error",
    "vitest/no-conditional-expect": "error",
    "vitest/no-conditional-tests": "error",
    "vitest/require-test-timeout": "off",
    "@rikalabs/no-unlisted-external-imports": "off",
    "@rikalabs/no-generic-module-names": "off",
    "@rikalabs/no-placeholder-implementation": "off",
    "vitest/require-hook": "off",
    "shadcn/no-arbitrary-values": "error",
    "shadcn/no-inline-styles": "error",
    "shadcn/no-raw-colors": "error",
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"],
        "contracts": [
          {
            "allow": ["layout"],
            "deny": ["w-*", "h-*"],
            "pattern": "^Button$"
          },
          {
            "allow": ["layout"],
            "pattern": "^(Card|Input|Label)$"
          }
        ]
      }
    ],
    "shadcn/no-unknown-classes": "error",
    "shadcn/require-static-classes": "error",
    "react/rules-of-hooks": "off",
    "react-quality/react-in-jsx-scope": "off",
    "react-quality/jsx-props-no-spreading": "off",
    "@rikalabs/no-silent-catch-fallback": "error",
    "@rikalabs/no-is-record-helpers": "error",
    "@rikalabs/no-runtime-compat-fallbacks": "error",
    "@rikalabs/no-catch-return-error-object": "error",
    "@rikalabs/no-double-type-assertion": "error",
    "@rikalabs/no-ai-debt-comments": "error",
    "@rikalabs/no-json-parse-default-fallback": "error",
    "@rikalabs/no-json-stringify-default-fallback": "error",
    "@rikalabs/no-as-never": "error",
    "@rikalabs/no-todo-without-issue": "error",
    "@rikalabs/no-disable-without-rationale": "error",
    "@rikalabs/no-identical-branches": "error",
    "@rikalabs/no-copy-paste-exports": "error",
    "@rikalabs/no-trivial-runtime-guard-helpers": "error",
    "@rikalabs/no-trivial-property-helpers": "error",
    "@rikalabs/no-bare-wrapper-functions": "error",
    "@rikalabs/no-pass-through-intermediate-vars": "error",
    "@rikalabs/no-redundant-const-assertion": "error",
    "@rikalabs/no-tutorial-comments": "error",
    "@rikalabs/no-commented-out-code": "error",
    "@rikalabs/no-debug-residue-filenames": "error",
    "@rikalabs/no-low-signal-variable-names": "error",
    "@rikalabs/effect-no-async-await": "error",
    "@rikalabs/effect-no-generic-error-fail": "error",
    "@rikalabs/effect-no-layer-in-leaf-modules": "error",
    "@rikalabs/effect-no-or-die": "error",
    "@rikalabs/effect-no-promise-service-methods": "error",
    "@rikalabs/effect-no-provide-in-domain": "error",
    "@rikalabs/effect-no-terminal-runners": "error",
    "@rikalabs/effect-no-throw-in-services": "error",
    "@rikalabs/effect-no-try-catch": "error",
    "@rikalabs/effect-require-tagged-errors": "error",
    "@rikalabs/no-standalone-classes": "error",
    "@rikalabs/no-sql-string-concat": "error",
    "@rikalabs/no-exported-any": "error",
    "@rikalabs/no-inline-exported-object-types": "error",
    "@rikalabs/no-bag-of-optionals": "error",
    "@rikalabs/require-branded-ids": "error",
    "@rikalabs/require-exhaustive-tag-switch": "error",
    "@rikalabs/no-relative-cross-package-imports": "error",
    "unicorn/max-nested-calls": "off",
    "@rikalabs/no-cross-layer-imports": "error",
    "@rikalabs/no-placeholder-tests": "error",
    "@rikalabs/no-mock-only-tests": "error",
    "drizzle/enforce-delete-with-where": "error",
    "drizzle/enforce-update-with-where": "error",
    "vitest/consistent-test-filename": "error",
    "vitest/prefer-called-once": "error",
    "vitest/prefer-called-times": "error",
    "vitest/prefer-to-be-object": "error",
    "@rikalabs/no-hardcoded-secrets": "error"
  },
  "overrides": [
    {
      "files": ["packages/ui/**"],
      "rules": {
        "react-quality/forbid-component-props": "off",
        "react-quality/jsx-props-no-spreading": "off",
        "react-quality/react-in-jsx-scope": "off",
        "react/button-has-type": "off",
        "shadcn/no-restyle": "off"
      }
    },
    {
      "files": ["packages/ui/src/components/ui/label.tsx"],
      "rules": {
        "jsx-a11y/label-has-associated-control": "off"
      }
    },
    {
      "files": ["apps/**/proofs/**", "packages/**/proofs/**"],
      "rules": {
        "gdp-ts/no-define-proof": "off"
      }
    },
    {
      "files": ["packages/db/src/**"],
      "rules": {
        "eslint/no-restricted-imports": "off",
        "import/group-exports": "off",
        "import/no-namespace": "off"
      }
    },
    {
      "files": [
        "**/src/db/migrations/**",
        "**/src/db/internal/**",
        "packages/db/drizzle/**"
      ],
      "rules": {
        "eslint/no-restricted-properties": "off"
      }
    },
    {
      "files": ["**/*.config.*"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["**/*.test.*", "**/*.spec.*", "test/**", "tests/**"],
      "rules": {
        "vitest/prefer-strict-boolean-matchers": "error",
        "vitest/prefer-to-be-falsy": "off",
        "vitest/prefer-to-be-truthy": "off",
        "vitest/require-hook": "error",
        "eslint/max-lines": [
          "error",
          {
            "max": 1000,
            "skipBlankLines": true,
            "skipComments": true
          }
        ],
        "eslint/max-lines-per-function": [
          "error",
          {
            "max": 120,
            "skipBlankLines": true,
            "skipComments": true
          }
        ],
        "eslint/max-statements": ["error", 80],
        "react/no-multi-comp": "off",
        "react-quality/no-giant-component": "off"
      }
    },
    {
      "files": ["**/test-setup.*"],
      "rules": {
        "eslint/require-await": "off",
        "typescript/require-await": "off",
        "vitest/no-hooks": "off",
        "vitest/require-top-level-describe": "off"
      }
    },
    {
      "files": ["**/e2e/**"],
      "rules": {
        "vitest/prefer-importing-vitest-globals": "off"
      }
    },
    {
      "files": ["packages/core/src/api/router.ts"],
      "rules": {
        "@rikalabs/effect-no-async-await": "off",
        "@rikalabs/effect-no-terminal-runners": "off"
      }
    },
    {
      "files": ["packages/db/src/query-capture.ts"],
      "rules": {
        "@rikalabs/no-trivial-runtime-guard-helpers": "off",
        "import/no-nodejs-modules": "off",
        "unicorn/no-null": "off"
      }
    },
    {
      "files": ["packages/core/src/telemetry-node.ts"],
      "rules": {
        "@rikalabs/effect-no-layer-in-leaf-modules": "off"
      }
    },
    {
      "files": ["apps/**", "packages/core/**", "packages/ui/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "message": "Database implementation belongs in @template/db adapters; inject a repository or port instead.",
            "patterns": ["drizzle-orm", "drizzle-orm/**"]
          },
          {
            "message": "The Postgres driver belongs in @template/db; inject a database port instead.",
            "name": "postgres"
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["dist", "coverage", "node_modules"]
}
