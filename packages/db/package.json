{
  "name": "@template/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./devtools/query-plans": "./src/devtools/query-plans.ts",
    "./env": "./src/env.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "query-plans": "node --experimental-strip-types ../../devtools/scripts/database/run-query-plans.ts",
    "query-plans:prepare": "node --experimental-strip-types ../../devtools/scripts/database/prepare-query-plans.ts",
    "query-corpus:merge": "node --experimental-strip-types ../../devtools/scripts/database/merge-query-corpus.ts",
    "query-plan-stats:export": "node --experimental-strip-types ../../devtools/scripts/database/export-query-plan-stats.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@t3-oss/env-core": "0.13.11",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "postgres": "3.4.9",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  }
}
