{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "records"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["test", "method", "owner", "revision", "command", "redState"],
        "additionalProperties": false,
        "properties": {
          "test": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "enum": ["attestation", "execution"]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,40}$"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "redState": {
            "type": "string",
            "minLength": 12
          },
          "artifact": {
            "type": "string"
          }
        }
      }
    }
  }
}
