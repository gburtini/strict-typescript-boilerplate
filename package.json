{
  "name": "typescript-boilerplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:check": "node --experimental-strip-types scripts/check-package-exports.ts",
    "architecture:fixtures": "node --experimental-strip-types scripts/check-architecture-fixtures.ts",
    "build": "pnpm --filter @template/web build",
    "check": "pnpm check:runtime && pnpm format:check && pnpm api:check && pnpm typecheck && pnpm lint && pnpm exceptions:check && pnpm enforcement:fixtures && pnpm architecture:fixtures && pnpm generated:check && pnpm test:evidence && pnpm enforcement:manifest:check && pnpm deadcode && pnpm deps && pnpm packages && pnpm test",
    "check:all": "pnpm check && pnpm build && pnpm test:e2e",
    "check:runtime": "node --experimental-strip-types scripts/check-runtime.ts",
    "deadcode": "NODE_OPTIONS=--disable-warning=DEP0205 knip --strict",
    "deps": "dependency-cruiser --validate .dependency-cruiser.cjs apps packages",
    "dev": "pnpm --filter @template/web dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "enforcement:fixtures": "node --experimental-strip-types scripts/check-enforcement-fixtures.ts",
    "enforcement:manifest:check": "node --experimental-strip-types scripts/generate-enforcement-manifest.ts",
    "enforcement:manifest:write": "node --experimental-strip-types scripts/generate-enforcement-manifest.ts --write",
    "exceptions:check": "node --experimental-strip-types scripts/check-exceptions.ts",
    "generated:check": "node --experimental-strip-types scripts/check-generated.ts",
    "lint": "oxlint -c oxlint.config.ts --type-aware --type-check --deny-warnings --report-unused-disable-directives-severity error apps packages scripts oxlint.config.ts",
    "lint:fix": "oxlint -c oxlint.config.ts --fix apps packages scripts oxlint.config.ts",
    "packages": "sherif --fail-on-warnings --ignore-rule root-package-dependencies",
    "preview": "pnpm --filter @template/web preview",
    "coverage:ratchet": "node --experimental-strip-types scripts/check-coverage-ratchet.ts",
    "test": "pnpm --filter @template/web test && pnpm coverage:ratchet",
    "test:evidence": "node --experimental-strip-types scripts/check-test-evidence.ts",
    "test:e2e": "pnpm --filter @template/web test:e2e",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.json"
  },
  "devDependencies": {
    "@rikalabs/oxlint-standards": "0.8.1",
    "@shadcn/lint": "0.1.1",
    "@types/node": "24.13.4",
    "dependency-cruiser": "18.2.0",
    "knip": "6.35.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-plugin-react-doctor": "0.9.12",
    "oxlint-tsgolint": "7.0.2001",
    "sherif": "1.13.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.30.3"
}
