{
  "name": "typescript-boilerplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:check": "node --experimental-strip-types devtools/scripts/repository/check-package-exports.ts",
    "architecture:fixtures": "node --experimental-strip-types devtools/scripts/repository/check-architecture-fixtures.ts",
    "ci:policy": "node --experimental-strip-types devtools/scripts/repository/check-ci-policy.ts",
    "build": "pnpm --filter @template/web build",
    "check": "pnpm check:runtime && pnpm toolchain:check && pnpm format:check && pnpm api:check && pnpm db:migrations:check && pnpm typecheck && pnpm lint && pnpm semantic:check && pnpm exceptions:check && pnpm semgrep:check && pnpm enforcement:fixtures && pnpm architecture:fixtures && pnpm ci:policy && pnpm initialization:fixtures && pnpm governance:fixtures && pnpm generated:check && pnpm test:regressions && pnpm enforcement:manifest:check && pnpm deadcode && pnpm deps && pnpm packages && pnpm test",
    "check:all": "node --experimental-strip-types devtools/scripts/repository/run-full-check.ts",
    "check:runtime": "node --experimental-strip-types devtools/scripts/repository/check-runtime.ts",
    "db:check": "drizzle-kit check --config packages/db/drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config packages/db/drizzle.config.ts",
    "db:migrations:check": "node --experimental-strip-types devtools/scripts/repository/check-db-migrations.ts",
    "db:studio": "drizzle-kit studio --config packages/db/drizzle.config.ts",
    "db:query-corpus:report": "node --experimental-strip-types devtools/scripts/database/report-query-corpus.ts",
    "db:query-corpus:merge": "pnpm --filter @template/db query-corpus:merge",
    "db:query-plan-stats:export": "pnpm --filter @template/db query-plan-stats:export",
    "db:plans:compare": "node --experimental-strip-types devtools/scripts/database/compare-query-plans.ts",
    "db:plans": "pnpm --filter @template/db query-plans",
    "db:plans:prepare": "pnpm --filter @template/db query-plans:prepare",
    "db:plans:reset": "pnpm --filter @template/db query-plans:reset",
    "deadcode": "NODE_OPTIONS=--disable-warning=DEP0205 knip --strict",
    "deps": "pnpm --dir devtools/dependency-cruiser exec dependency-cruiser --config dependency-cruiser.cjs ../../apps ../../packages",
    "dev": "node --experimental-strip-types devtools/scripts/repository/develop.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "enforcement:fixtures": "node --experimental-strip-types devtools/scripts/repository/check-enforcement-fixtures.ts",
    "enforcement:manifest:check": "node --experimental-strip-types devtools/scripts/repository/generate-enforcement-manifest.ts",
    "enforcement:manifest:write": "node --experimental-strip-types devtools/scripts/repository/generate-enforcement-manifest.ts --write",
    "exceptions:check": "node --experimental-strip-types devtools/scripts/repository/check-exceptions.ts",
    "generated:check": "node --experimental-strip-types devtools/scripts/repository/check-generated.ts",
    "lint": "oxlint -c oxlint.config.ts --type-aware --type-check --deny-warnings --report-unused-disable-directives-severity error apps packages devtools/scripts oxlint.config.ts",
    "lint:fix": "oxlint -c oxlint.config.ts --fix apps packages devtools/scripts oxlint.config.ts",
    "lint:semantic": "node --experimental-strip-types devtools/scripts/repository/check-semantic-lint.ts --base origin/main",
    "lint:semantic:eval": "node --experimental-strip-types devtools/scripts/repository/check-semantic-lint.ts --eval",
    "semantic:check": "node --experimental-strip-types devtools/scripts/repository/check-semantic-lint.ts --check",
    "packages": "sherif --fail-on-warnings --ignore-rule root-package-dependencies",
    "prepare": "effect-tsgo patch --oxlint --typescript",
    "preview": "pnpm --filter @template/web preview",
    "coverage:ratchet": "node --experimental-strip-types devtools/scripts/repository/check-coverage-ratchet.ts",
    "test": "pnpm test:unit && pnpm coverage:ratchet",
    "test:unit": "pnpm --filter @template/core test && pnpm --filter @template/db test && pnpm --filter @template/web test",
    "test:integration": "node --experimental-strip-types devtools/scripts/database/verify-database.ts",
    "test:regressions": "node --experimental-strip-types devtools/scripts/repository/check-regressions.ts",
    "test:e2e": "pnpm --filter @template/web test:e2e",
    "toolchain:check": "node --experimental-strip-types devtools/scripts/repository/check-toolchain.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p devtools/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.json && tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/db/tsconfig.json",
    "governance:fixtures": "node --experimental-strip-types devtools/scripts/repository/check-governance-fixtures.ts",
    "semgrep:check": "node --experimental-strip-types devtools/scripts/repository/check-semgrep.ts",
    "compiler:check": "pnpm --filter @template/web compiler:check",
    "start": "pnpm --filter @template/web start",
    "dev:web": "pnpm --filter @template/web dev",
    "browser:install": "pnpm --filter @template/web exec playwright install chromium",
    "init:project": "node --experimental-strip-types devtools/scripts/repository/initialize-project.ts",
    "initialization:fixtures": "node --experimental-strip-types devtools/scripts/repository/check-initialization-fixtures.ts",
    "initialization:smoke": "node --experimental-strip-types devtools/scripts/repository/check-initialized-project.ts"
  },
  "devDependencies": {
    "@effect/tsgo": "0.47.1",
    "@gdp-ts/core": "0.1.0",
    "@rikalabs/oxlint-standards": "0.8.1",
    "@shadcn/lint": "0.1.1",
    "@template/db": "workspace:*",
    "@types/node": "24.13.4",
    "@typescript-eslint/utils": "8.70.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "ai": "7.0.105",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "eslint-plugin-drizzle": "0.2.3",
    "knip": "6.35.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.86.0",
    "oxlint-plugin-react-doctor": "0.9.12",
    "oxlint-tsgolint": "7.0.2003",
    "postgres": "3.4.9",
    "sherif": "1.13.0",
    "typescript": "npm:typescript@7.0.2",
    "yaml": "2.9.1",
    "zod": "4.1.13"
  },
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "packageManager": "pnpm@10.30.3"
}
