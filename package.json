{
  "name": "typescript-boilerplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @template/web build",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm deadcode && pnpm deps && pnpm packages && pnpm test",
    "deadcode": "NODE_OPTIONS=--disable-warning=DEP0205 knip --strict",
    "deps": "dependency-cruiser --validate .dependency-cruiser.cjs apps packages",
    "dev": "pnpm --filter @template/web dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint -c oxlint.config.ts --type-aware --type-check --deny-warnings --report-unused-disable-directives-severity error apps packages",
    "lint:fix": "oxlint -c oxlint.config.ts --fix apps packages",
    "packages": "sherif --fail-on-warnings --ignore-rule root-package-dependencies",
    "preview": "pnpm --filter @template/web preview",
    "test": "pnpm --filter @template/web test",
    "test:e2e": "pnpm --filter @template/web test:e2e",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.json"
  },
  "devDependencies": {
    "@rikalabs/oxlint-standards": "0.8.1",
    "@shadcn/lint": "0.1.1",
    "@types/node": "25.9.3",
    "dependency-cruiser": "18.2.0",
    "knip": "6.35.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-plugin-react-doctor": "0.9.12",
    "oxlint-tsgolint": "7.0.2001",
    "sherif": "1.13.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.30.3"
}
