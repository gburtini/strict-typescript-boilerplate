{
  "name": "typescript-boilerplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:check": "node --experimental-strip-types scripts/check-package-exports.ts",
    "architecture:fixtures": "node --experimental-strip-types scripts/check-architecture-fixtures.ts",
    "ci:policy": "node --experimental-strip-types scripts/check-ci-policy.ts",
    "build": "pnpm --filter @template/web build",
    "check": "pnpm check:runtime && pnpm toolchain:check && pnpm format:check && pnpm api:check && pnpm db:migrations:check && pnpm typecheck && pnpm lint && pnpm exceptions:check && pnpm enforcement:fixtures && pnpm architecture:fixtures && pnpm ci:policy && pnpm generated:check && pnpm test:evidence && pnpm enforcement:manifest:check && pnpm deadcode && pnpm deps && pnpm packages && pnpm test",
    "check:all": "pnpm check && pnpm build && pnpm test:e2e",
    "check:runtime": "node --experimental-strip-types scripts/check-runtime.ts",
    "db:check": "drizzle-kit check --config packages/db/drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config packages/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config packages/db/drizzle.config.ts",
    "db:migrations:check": "node --experimental-strip-types scripts/check-db-migrations.ts",
    "db:studio": "drizzle-kit studio --config packages/db/drizzle.config.ts",
    "db:query-corpus:report": "node --experimental-strip-types scripts/report-query-corpus.ts",
    "db:query-corpus:merge": "pnpm --filter @template/db query-corpus:merge",
    "db:query-plan-stats:export": "pnpm --filter @template/db query-plan-stats:export",
    "db:plans": "pnpm --filter @template/db query-plans",
    "db:plans:prepare": "pnpm --filter @template/db query-plans:prepare",
    "deadcode": "NODE_OPTIONS=--disable-warning=DEP0205 knip --strict",
    "deps": "dependency-cruiser --validate .dependency-cruiser.cjs apps packages",
    "dev": "pnpm --filter @template/web dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "enforcement:fixtures": "node --experimental-strip-types scripts/check-enforcement-fixtures.ts",
    "enforcement:manifest:check": "node --experimental-strip-types scripts/generate-enforcement-manifest.ts",
    "enforcement:manifest:write": "node --experimental-strip-types scripts/generate-enforcement-manifest.ts --write",
    "exceptions:check": "node --experimental-strip-types scripts/check-exceptions.ts",
    "generated:check": "node --experimental-strip-types scripts/check-generated.ts",
    "lint": "oxlint -c oxlint.config.ts --type-aware --type-check --deny-warnings --report-unused-disable-directives-severity error apps packages scripts oxlint.config.ts",
    "lint:fix": "oxlint -c oxlint.config.ts --fix apps packages scripts oxlint.config.ts",
    "packages": "sherif --fail-on-warnings --ignore-rule root-package-dependencies",
    "prepare": "effect-tsgo patch --oxlint --typescript",
    "preview": "pnpm --filter @template/web preview",
    "coverage:ratchet": "node --experimental-strip-types scripts/check-coverage-ratchet.ts",
    "test": "pnpm --filter @template/core test && pnpm --filter @template/db test && pnpm --filter @template/web test && pnpm coverage:ratchet",
    "test:evidence": "node --experimental-strip-types scripts/check-test-evidence.ts",
    "test:e2e": "pnpm --filter @template/web test:e2e",
    "toolchain:check": "node --experimental-strip-types scripts/check-toolchain.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && tsc --noEmit -p packages/ui/tsconfig.json && tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/db/tsconfig.json"
  },
  "devDependencies": {
    "@effect/tsgo": "0.45.0",
    "@rikalabs/oxlint-standards": "0.8.1",
    "@shadcn/lint": "0.1.1",
    "@template/db": "workspace:*",
    "@types/node": "24.13.4",
    "@typescript-eslint/utils": "8.70.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "dependency-cruiser": "18.3.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "eslint-plugin-drizzle": "0.2.3",
    "knip": "6.35.0",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-plugin-react-doctor": "0.9.12",
    "oxlint-tsgolint": "7.0.2001",
    "sherif": "1.13.0",
    "typescript": "npm:typescript@7.0.2",
    "yaml": "2.9.1",
    "zod": "4.1.13"
  },
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "packageManager": "pnpm@10.30.3"
}
